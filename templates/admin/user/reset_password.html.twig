{% extends '@EasyAdmin/page/content.html.twig' %}
{% form_theme form '@EasyAdmin/crud/form_theme.html.twig' %}

{% block page_title %}Réinitialiser le mot de passe{% endblock %}
{% block content_title %}Réinitialiser le mot de passe{% endblock %}

{% block main %}
    <p>Compte : <strong>{{ user.displayName }}</strong> ({{ user.email }})</p>

    {{ form_start(form) }}
        {{ form_row(form.plainPassword) }}
        <div class="page-actions">
            <button type="submit" class="btn btn-primary">Enregistrer</button>
            <a class="btn" href="{{ cancelUrl }}">Annuler</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
