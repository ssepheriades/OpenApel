{% extends 'base.html.twig' %}

{% block title %}Staff Login{% endblock %}

{% block body %}
    <main style="min-height: 100vh; display: grid; place-items: center; background: #f5f7fb; padding: 2rem;">
        <section style="width: min(100%, 26rem); background: #ffffff; border: 1px solid #d9e0ea; border-radius: 8px; padding: 2rem; box-shadow: 0 12px 32px rgba(15, 23, 42, 0.08);">
            {% set site = site_settings() %}
            {% if site.logoUrl %}
                <img src="{{ site.logoUrl }}" alt="" style="max-height: 4rem; max-width: 100%; margin-bottom: 1rem;" />
            {% endif %}
            <h1 style="margin: 0 0 0.5rem; font-size: 1.5rem;">{{ site.siteName }} Admin</h1>
            <p style="margin: 0 0 1.5rem; color: #475569;">Staff sign in</p>

            {% if error %}
                <div style="margin-bottom: 1rem; padding: 0.75rem 1rem; border-radius: 6px; background: #fef2f2; color: #b91c1c;">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <form method="post">
                <label for="username" style="display: block; margin-bottom: 0.375rem; font-weight: 600;">Email</label>
                <input
                    type="email"
                    id="username"
                    name="_username"
                    value="{{ last_username }}"
                    autocomplete="email"
                    required
                    autofocus
                    style="width: 100%; margin-bottom: 1rem; padding: 0.75rem 0.875rem; border: 1px solid #cbd5e1; border-radius: 6px;"
                />

                <label for="password" style="display: block; margin-bottom: 0.375rem; font-weight: 600;">Password</label>
                <input
                    type="password"
                    id="password"
                    name="_password"
                    autocomplete="current-password"
                    required
                    style="width: 100%; margin-bottom: 1rem; padding: 0.75rem 0.875rem; border: 1px solid #cbd5e1; border-radius: 6px;"
                />

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button
                    type="submit"
                    style="width: 100%; padding: 0.75rem 1rem; border: 0; border-radius: 6px; background: #0f172a; color: #ffffff; font-weight: 600; cursor: pointer;"
                >
                    Sign in
                </button>
            </form>
        </section>
    </main>
{% endblock %}
