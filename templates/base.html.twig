<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        {% set site = site_settings() %}
        <title>{% block title %}{{ site.siteName }}{% endblock %}</title>
        {% if site.faviconUrl %}
            <link rel="icon" href="{{ site.faviconUrl }}" />
        {% endif %}
        {% block stylesheets %}
        {% endblock %}
    </head>
    <body>
        {% block body %}{% endblock %}
        {% block javascripts %}
        {% endblock %}
    </body>
</html>
