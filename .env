###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=changeme_generate_with_openssl_rand_hex_32
APP_DEBUG=1
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=changeme
DATABASE_URL=
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> vite ###
VITE_API_URL=/api
###< vite ###

###> openapel ###
# Required per deployment. Lowercase slug (a-z, 0-9, hyphen), used as a folder under UPLOAD_DIR.
APP_INSTANCE=dev
UPLOAD_DIR=%kernel.project_dir%/var/storage
###< openapel ###

###> Reverse proxy (Coolify Traefik / Caddy) ###
# REMOTE_ADDR trusts the immediate peer (correct behind Coolify's Docker network).
# Unused by DDEV/Symfony CLI locally unless you put a proxy in front.
TRUSTED_PROXIES=REMOTE_ADDR
# FrankenPHP listen address in the prod image. Coolify uses ":8080" (non-root).
SERVER_NAME=:8080
###< Reverse proxy ###

###> Production only (not needed for local dev) ###
APP_DOMAIN=localhost
REGISTRY=registry.example.com
IMAGE_TAG=latest
ACME_EMAIL=admin@example.com
###< Production ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

