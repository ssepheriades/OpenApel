# Copy values into Coolify → Environment Variables.
# Do NOT commit a real .env.prod (gitignored). Never put secrets in the image.

### Symfony
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=  # openssl rand -hex 32

### Instance (one Coolify app = one school)
APP_INSTANCE=my-school
UPLOAD_DIR=/app/var/storage

### PostgreSQL 18 (Coolify database resource)
# Prefer Coolify "Connect to database" which injects DATABASE_URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?serverVersion=18&charset=utf8"

### Public URL (link generation, absolute URLs)
DEFAULT_URI=https://asso.example.org

### Mail
MAILER_DSN=smtp://USER:PASSWORD@smtp.example.org:587

### Reverse proxy (Coolify Traefik)
TRUSTED_PROXIES=REMOTE_ADDR
# Trusted headers are fixed in config/packages/framework.yaml
# (x-forwarded-for/host/proto/port/prefix) — no env needed.
SERVER_NAME=:8080

### Optional frontend bake (already set at image build)
# VITE_API_URL=/api
